# Test configuration of the SAP_BASIS 7.40 SP04 system — the legacy live checks
# only (src/__tests__/integration/legacy/), over RFC. Not the main system's
# configuration: that one is test-config.yaml.
#
# Usage:
#   cp src/__tests__/helpers/test-config.legacy-740.yaml.template \
#      src/__tests__/helpers/test-config.legacy-740.yaml      # gitignored
#   # Edit the lines marked "# ← CHANGE"; then name it for every run:
#   export MCP_TEST_CONFIG_PATH=src/__tests__/helpers/test-config.legacy-740.yaml
#   export MCP_ENV_PATH=<the .env with the 7.40 system's SAP_URL, SAP_USERNAME,
#                       SAP_PASSWORD, SAP_CLIENT (and SAP_UNICODE=false if non-unicode)>
#
# Then, with the RFC SDK on the path (SAPNWRFC_HOME, PATH, LD_LIBRARY_PATH):
#   npm run legacy:setup                                 # the environment (below)
#   npm run test:detached -- integration/legacy          # the live checks
#   npm run legacy:teardown                              # when no longer needed
#
# The test environment (src/__tests__/helpers/legacyEnv.ts, ABAP classes in
# src/__tests__/integration/legacy/abap/) touches only names with the prefix
# ZLG7 (ZCL_LG7_*, ZIF_LG7_*, ZLG7*, Z_LG7_*) in $TMP or in package ZLG7_TEST,
# requests of the current user whose text starts with "ZLG7 LEGACY-TEST", and
# that user's locks and inactive versions on those names. legacy:setup creates
# the request and package ZLG7_TEST (on the software component and transport
# layer below) and the fixtures; legacy:teardown deletes all of it and the
# requests — it never releases one.

test_settings:
  fail_fast: false
  verbose: true
  timeout: 60000
  retry_on_failure: false
  max_retries: 1
  cleanup_after_test: true
  allow_406: false
  timeouts:
    default: 60000
    long: 200000
    create: 60000
    delay: 3000

session_config:
  cleanup_session_after_test: false

lock_config:
  locks_dir: ".locks"
  persist_locks: true

environment:
  system: "onprem"
  connection_type: "rfc"                      # the legacy client is supported over RFC only
  is_legacy: true
  default_package: "$TMP"
  default_transport: ""
  default_master_system: "<SID>"              # ← CHANGE: the 7.40 system's ID
  default_master_language: ""
  skip_cleanup: false

# The transportable package ZLG7_TEST the environment creates (legacy:setup)
# and removes (legacy:teardown). The 7.40 system's own values; the helper
# admits A-Z, 0-9, _ and / only.
legacy_env:
  software_component: "<SOFTWARE_COMPONENT>"  # ← CHANGE: e.g. the customer component of the system
  transport_layer: "<TRANSPORT_LAYER>"        # ← CHANGE: the system's transport layer (up to 4 characters)

# Live checks of the legacy client (AdtClientLegacy, AdtExecutorLegacy) on a
# SAP_BASIS 7.40 SP04 system. They run only when environment.is_legacy is true
# and environment.connection_type is "rfc"; elsewhere they skip and say why.
# Enabled here: this file is the 7.40 system's own configuration.
#
# Every name here carries the prefix ZLG7 (ZCL_LG7_*, ZIF_LG7_*, ZLG7_*,
# Z_LG7_*): the test environment (npm run legacy:setup / legacy:teardown,
# src/__tests__/helpers/legacyEnv.ts) cleans and removes exactly that prefix.
# - The fixtures (ZCL_LG7_FX_UNIT, ZLG7_FX_UNIT, ZLG7_FX with Z_LG7_FX_UNIT and
#   its test include) are created by legacy:setup in $TMP; their names are
#   fixed there (legacyEnv.ts FIXTURES), not here.
# - legacy_deletes and legacy_function_include create objects of their own in
#   $TMP and delete them; legacy_transportable creates one in package
#   ZLG7_TEST on the environment's request. Name objects that do not exist,
#   keeping the prefix; leftovers of a crashed run are removed by legacy:setup.
legacy_740:
  test_cases:
    - name: "legacy_deletes"
      enabled: true
      available_in: ["legacy"]
      description: "Lock, delete with the lock handle, unlock, read answers 404 — class, program, interface, function group, function module, DDL source; a delete without a handle answers 400 for the first four"
      params:
        class_name: "ZCL_LG7_DEL"                 # a ZLG7 name that does not exist yet
        program_name: "ZLG7_DEL"
        interface_name: "ZIF_LG7_DEL"
        function_group_name: "ZLG7_DELG"
        function_module_name: "Z_LG7_DEL"
        ddl_name: "ZLG7_DEL_DDL"
    - name: "legacy_refusals_send_nothing"
      enabled: true
      available_in: ["legacy"]
      description: "checkDeletion, the absentOnLegacy handlers and the other refused members answer the refusal and send no request (asserted on the wire recorder); readObjectMetadata/readObjectSource for a program and a class answer 200"
      params:
        # The refused members are called with placeholders; nothing is sent.
        class_name: "ZCL_LG7_FX_UNIT"             # the fixture (legacy:setup), read for the 200 cases
        program_name: "ZLG7_FX_UNIT"              # the fixture (legacy:setup), read for the 200 cases
    - name: "legacy_unit_runners"
      enabled: true
      available_in: ["legacy"]
      description: "Class, program and function group run/runSync and function module runSync answer the methods of an object with tests, with <options> sent"
      params:
        class_name: "ZCL_LG7_FX_UNIT"             # the fixtures legacy:setup creates
        program_name: "ZLG7_FX_UNIT"
        function_group_name: "ZLG7_FX"
        function_module_name: "Z_LG7_FX_UNIT"
    - name: "legacy_function_include"
      enabled: true
      available_in: ["legacy"]
      description: "A function include created with the v1 pair, written and activated"
      params:
        # The include's own delete is refused on 7.40, so the test creates this
        # group, creates the include in it, and deletes the group with it.
        function_group_name: "ZLG7_FI"            # a ZLG7 name that does not exist yet
        include_name: "LZLG7_FIF01"               # L<group>F01
    - name: "legacy_transports"
      enabled: true
      available_in: ["legacy"]
      description: "Transport list and readMetadata answer the user's list from /sap/bc/cts"
      params: {}
    - name: "legacy_transportable"
      enabled: true
      available_in: ["legacy"]
      description: "In package ZLG7_TEST on the environment's request: create, lock → update with corrNr → unlock, the transport list and readMetadata show the request, lock → DELETE ?lockHandle=&corrNr= → unlock"
      params:
        # The package and the request are the environment's (legacy:setup).
        program_name: "ZLG7_TR_PROG"              # a ZLG7 name that does not exist yet
