# This package installs on its own (`npm ci --prefix packages/adt-strategies`,
# not a workspace), and npm reads the project .npmrc of the directory it
# installs in — the root's does not reach here. So the same hardening again.

# Supply-chain hardening (Shai-Hulud and its kind spread through install
# scripts). A dependency's install script runs only when package.json
# `allowScripts` allows it; an unreviewed one fails the install instead of
# running. Read in full from npm 11.19.0 (earlier npm: in part or not at
# all), so CI and the release workflow install with --ignore-scripts.
strict-allow-scripts=true
# Resolve only versions published at least 7 days ago (Dependabot's cooldown).
min-release-age=7
# Except this project's own scope: the chain releases its packages to each
# other the same day. Their own dependencies still follow the 7 days.
min-release-age-exclude[]=@mcp-abap-adt/*
