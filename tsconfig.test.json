{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "typeRoots": ["./node_modules/@types"]
  },
  "include": [
    // Every script, not a hand-picked few. They are the tools we point
    // people at, and one that prints a confidently wrong listing is worse
    // than one that fails — which is what happened while nothing compiled
    // them: `is_package` and `adtType` were renamed, the scripts kept the
    // old names, and at runtime they read `undefined` and took the wrong
    // branch in silence (#114).
    // And every example, for the same reason and a sharper one: the four
    // that used to live here called `CrudClient`, a class renamed several
    // majors before anyone noticed, so the directory a consumer opens
    // first contained nothing that could run.
    // And the workspace packages, so a script that crosses the seam between
    // them is checked at the seam. The trace field is why: the wrapper writes
    // `request`, a strategy read `config`, and unit tests on either side of
    // that mismatch both passed.
    "packages/*/src/**/*",
    "examples/**/*",
    "scripts/**/*",
    "src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
